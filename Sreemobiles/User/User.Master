<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User.master.cs" Inherits="Sri_Mobiles.User.User" %>



<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <title>Sri Mobile | Sales & Services</title>
    <link rel="icon" type="image/png" href="../Images/Icon.png" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- ================= INTERNAL CSS ================= -->
    <style>
        /* ================= GLOBAL ================= */
        body {
            margin: 0;
            padding-top: 90px;
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
        }

        a {
            text-decoration: none;
        }

        /* ================= NAVBAR ================= */
        .custom-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
        }

        .navbar .container {
            position: relative;
        }

        .navbar-nav {
            padding-left: 0;
            margin-bottom: 0;
        }
        /* ================= LOGO ================= */
        .logo-img {
            width: 42px;
        }

        .brand-text {
            font-size: 22px;
            font-weight: 700;
            color: #f7c600;
            margin-left: 6px;
        }

        /* ================= SEARCH ================= */
        .nav-search-center {
            position: absolute;
            left: 35%;
            transform: translateX(-50%);
            width: 460px;
        }

        .search-box {
            padding: 10px 14px;
            font-size: 15px;
            border: 1px solid #f7c600;
        }


            .search-box:focus {
                outline: none;
                box-shadow: none;
                border-color: #f7c600;
            }

            .search-box:hover {
                border-color: black;
            }

        /* ================= MENU BUTTONS ================= */
        .nav-btn-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-btn {
            padding: 6px 2px;
            background: none;
            border: none;
            font-size: 16px;
            font-weight: 600;
            color: #3a2f2f;
            cursor: pointer;
            transition: color 0.25s ease;
        }

            .nav-btn:hover {
                color: #f7c600;
            }

            .nav-btn:focus {
                outline: none;
                box-shadow: none;
            }



        /* ================= ICONS ================= */
        .nav-icons {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-left: 20px;
        }

        .nav-icon {
            position: relative;
            font-size: 20px;
            color: #3a2f2f;
        }

            .nav-icon:hover {
                color: #f7c600;
            }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -10px;
            min-width: 18px;
            height: 18px;
            background: red;
            color: white;
            font-size: 11px;
            font-weight: 600;
            line-height: 18px;
            text-align: center;
            border-radius: 50%;
        }

        /* ================= FOOTER ================= */
        .footer {
            background: #2a1f1f;
            color: #fef3c7;
            padding: 30px 0;
        }

            .footer a {
                color: #fef3c7;
            }

                .footer a:hover {
                    color: #f7d042;
                }

        .footer-links {
            list-style: none;
            padding: 0;
        }

            .footer-links li {
                margin-bottom: 8px;
            }


        /* ================= FLOATING BUTTONS ================= */
        .floating-wrapper {
            position: fixed;
            right: 20px;
            z-index: 999;
        }

            .floating-wrapper.call {
                bottom: 100px;
            }

            .floating-wrapper.whatsapp {
                bottom: 30px;
            }

        .floating-call,
        .floating-whatsapp {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #fff;
        }

        .floating-call {
            background: #25D366;
        }

        .floating-whatsapp {
            background: #25D366;
        }

        .floating-tooltip {
            position: absolute;
            right: 65px;
            background: #000;
            color: #fff;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 12px;
            opacity: 0;
            transition: 0.3s;
            white-space: nowrap;
        }

        .floating-wrapper:hover .floating-tooltip {
            opacity: 1;
        }



        /* ================= RESPONSIVE ================= */
        @media (max-width: 1100px) {
            .nav-search-center {
                width: 380px;
            }
        }

        @media (max-width: 991px) {
            .nav-search-center {
                position: static;
                transform: none;
                width: 100%;
                margin: 12px 0;
            }

            .nav-btn-group,
            .nav-icons {
                justify-content: center;
                margin-top: 10px;
            }
        }

        @media (max-width: 576px) {
            body {
                padding-top: 70px;
            }

            .nav-btn-group {
                flex-direction: column;
                width: 100%;
            }

            .nav-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <form runat="server">

        <!-- ================= NAVBAR ================= -->
        <nav class="navbar navbar-expand-lg fixed-top custom-navbar navbar-light">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand d-flex align-items-center" href="Home.aspx">
                    <img src="../Images/Logo.png" class="logo-img" alt="Sri Mobile Logo" />
                    <span class="brand-text">Sri Mobile</span>
                </a>

                <!-- TOGGLER -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse justify-content-end" id="navMenu">

                    <!-- SEARCH -->
                    <div class="nav-search-center" runat="server" id="searchBoxArea">

                        <div class="input-group">

                            <asp:TextBox ID="txtSearch" runat="server"
                                CssClass="form-control search-box"
                                placeholder="Search products..." />

                            <asp:LinkButton ID="btnSearch" runat="server"
                                CssClass="btn btn-warning"
                                OnClick="btnSearch_Click">
            <i class="fa fa-search"></i>
                            </asp:LinkButton>

                        </div>

                    </div>


                    <!-- MENU BUTTONS -->
                    <ul class="navbar-nav nav-btn-group">
                        <li class="nav-item">
                            <asp:LinkButton ID="btn_Home" runat="server" CssClass="nav-link nav-btn" OnClick="btn_Home_Click">🏠 Home</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btn_About" runat="server" CssClass="nav-link nav-btn" OnClick="btn_About_Click">ℹ️ About</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btn_Products" runat="server" CssClass="nav-link nav-btn" OnClick="btn_Products_Click">🛍 Products</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btn_Contact" runat="server" CssClass="nav-link nav-btn" OnClick="btn_Contact_Click">📞 Contact</asp:LinkButton>
                        </li>
                    </ul>

                    <!-- ICONS -->
                    <a href="CartPage.aspx" class="position-relative text-dark fs-5 me-3">
                        <i class="fa fa-shopping-cart"></i>

                        <asp:Label ID="lblCartCount" runat="server"
                            CssClass="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        </asp:Label>
                    </a>



                    <a class="nav-icon" href="Login.aspx">
                        <i class="fas fa-user"></i>
                    </a>
                </div>

            </div>

        </nav>

        <!-- ================= PAGE CONTENT ================= -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />


        <!-- ================= FOOTER ================= -->
        <footer class="footer">
            <div class="container">
                <div class="row">

                    <!-- COMPANY INFO -->
                    <div class="col-md-4 mb-3">
                        <h5>Sri Mobile</h5>

                        <p>
                            📍
                    <asp:HyperLink ID="hlLocation" runat="server"
                        NavigateUrl="https://www.google.com/maps/search/?api=1&query=Puthiragoundanpalayam"
                        Target="_blank">
                        Puthiragoundanpalayam
                    </asp:HyperLink>
                        </p>

                        <p>
                            📞
                    <asp:HyperLink ID="hlPhone1" runat="server" NavigateUrl="tel:+919965808071">
                        9965808071
                    </asp:HyperLink>
                            ,
                    <asp:HyperLink ID="hlPhone2" runat="server" NavigateUrl="tel:+919445441016">
                        9445441016
                    </asp:HyperLink>
                        </p>

                        <p>
                            ✉
                    <asp:HyperLink ID="hlEmail" runat="server"
                        NavigateUrl="mailto:srisystemspgp@gmail.com">
                        srisystemspgp@gmail.com
                    </asp:HyperLink>
                        </p>

                        <h5>Follow Us</h5>
                        <div class="social">
                            <asp:HyperLink ID="hlFacebook" runat="server" NavigateUrl="#" CssClass="me-2">
                        <i class="fab fa-facebook-f"></i>
                            </asp:HyperLink>

                            <asp:HyperLink ID="hlInstagram" runat="server" NavigateUrl="#" CssClass="me-2">
                        <i class="fab fa-instagram"></i>
                            </asp:HyperLink>

                            <asp:HyperLink ID="hlTwitter" runat="server" NavigateUrl="#">
                        <i class="fab fa-twitter"></i>
                            </asp:HyperLink>
                        </div>
                    </div>

                    <!-- PRODUCTS -->
                    <div class="col-md-4 mb-3">
                        <h5>Products</h5>
                        <ul class="footer-links">
                            <li>
                                <asp:LinkButton ID="lnkMobiles" runat="server">Mobiles</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkHeadphones" runat="server">Headphones</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkTV" runat="server">LED TVs</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkBattery" runat="server">Mobile Battery</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkScreen" runat="server">Mobile Screen</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkGlass" runat="server">Temperglass</asp:LinkButton></li>
                            <li>
                                <asp:LinkButton ID="lnkPouch" runat="server">Mobile pouch</asp:LinkButton></li>
                        </ul>
                    </div>

                    <!-- NAVIGATION -->
                    <div class="col-md-4 mb-3">
                        <h5>Further Info</h5>
                        <ul class="footer-links">
                            <li>
                                <asp:LinkButton ID="btnFooterHome" runat="server"
                                    OnClick="btnFooterHome_Click">
                            Home
                                </asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="btnFooterAbout" runat="server"
                                    OnClick="btnFooterAbout_Click">
                            About
                                </asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="btnFooterProducts" runat="server"
                                    OnClick="btnFooterProducts_Click">
                            Products
                                </asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="btnFooterContact" runat="server"
                                    OnClick="btnFooterContact_Click">
                            Contact us
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </footer>


        <!-- FLOATING BUTTONS -->
        <div class="floating-wrapper call">
            <a href="tel:9965808071" class="floating-call"><i class="fa fa-phone"></i></a>
            <span class="floating-tooltip">Call Us</span>
        </div>

        <div class="floating-wrapper whatsapp">
            <a href="https://wa.me/919965808071" target="_blank" class="floating-whatsapp">
                <i class="fab fa-whatsapp"></i>
            </a>
            <span class="floating-tooltip">Chat on WhatsApp</span>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    </form>
</body>
</html>



